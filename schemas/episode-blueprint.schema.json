{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aqaaab/faceless-youtube-shorts-n8n/schemas/episode-blueprint.schema.json",
  "title": "Automotive Episode Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode", "research", "facts", "story", "scenes", "visual_plan", "audio_plan", "shorts", "qa"],
  "properties": {
    "schema_version": {"type": "string"},
    "episode": {"type": "object"},
    "research": {"type": "object"},
    "facts": {"type": "array"},
    "story": {"type": "object"},
    "scenes": {"type": "array", "minItems": 25, "maxItems": 25},
    "visual_plan": {"type": "object"},
    "audio_plan": {"type": "object"},
    "shorts": {"type": "array", "minItems": 4, "maxItems": 4},
    "qa": {"type": "object"}
  }
}
