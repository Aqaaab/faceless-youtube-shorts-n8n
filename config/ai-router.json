{
  "version": 6,
  "name": "Aqaaab AI Router",
  "free_only": true,
  "fail_closed": true,
  "health_policy": "real_inference_when_provider_supports_it",
  "integration": {
    "long_story_engine": "scripts/patent_story_engine.py",
    "daily_pipeline": ".github/workflows/daily-production-v2.yml",
    "proof_fields": ["router", "router_task", "provider", "model"]
  },
  "tasks": {
    "long_story": {
      "min_output_tokens": 1400,
      "max_output_tokens": 4000,
      "providers": [
        "GitHubModels",
        "QwenCloud",
        "BlockRun:nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
        "BlockRun:nvidia/nemotron-nano-12b-v2-vl",
        "BlockRun:nvidia/nemotron-nano-9b-v2",
        "BlockRun:nvidia/mistral-nemotron",
        "Groq:openai/gpt-oss-120b",
        "Groq:openai/gpt-oss-20b",
        "Groq:qwen/qwen3.6-27b",
        "Gemini",
        "Cerebras",
        "Cohere",
        "Mistral",
        "SambaNova",
        "HuggingFace",
        "ZAI",
        "LLM7",
        "AnyAPI",
        "ArliAI",
        "OllamaCloud",
        "ModelScope",
        "Together",
        "OpenRouter",
        "Cloudflare"
      ]
    }
  },
  "classification": {
    "hard_disable": ["AUTH", "PAID_REQUIRED", "ACCESS_OR_QUOTA", "MODEL_NOT_FOUND"],
    "cooldown_seconds": {
      "RATE_LIMIT": 900,
      "TRANSIENT": 120,
      "SCHEMA_INVALID": 0
    }
  },
  "blockrun": {
    "base_url": "https://blockrun.ai/api/v1",
    "free_only": true,
    "api_key_required": false,
    "model_allow_list": [
      "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
      "nvidia/nemotron-nano-12b-v2-vl",
      "nvidia/nemotron-nano-9b-v2",
      "nvidia/mistral-nemotron"
    ],
    "model_discovery": true,
    "require_billing_mode": "free",
    "never_use_paid_model": true,
    "fallback_order": [
      "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
      "nvidia/nemotron-nano-12b-v2-vl",
      "nvidia/nemotron-nano-9b-v2",
      "nvidia/mistral-nemotron"
    ]
  },
  "cohere": {
    "base_url": "https://api.cohere.com/compatibility/v1",
    "api_key_env": "COHERE_API_KEY",
    "free_only": true,
    "api_key_required": true,
    "model_allow_list": ["command-r7b-12-2024"],
    "model_discovery": true,
    "never_use_paid_model": true
  },
  "qwencloud": {
    "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "allow_list": [
      "qwen3.6-flash",
      "qwen3.5-flash",
      "qwen3.6-plus",
      "qwen3.5-plus",
      "qwen3.7-flash",
      "qwen3.7-plus"
    ],
    "free_only": true,
    "model_discovery": true,
    "never_use_unlisted_model": true
  },
  "additional_providers": {
    "GitHubModels": {"base_url": "https://models.github.ai/inference", "api_key_env": "GITHUB_TOKEN", "default_model": "openai/gpt-4.1-mini", "free_only": true, "priority": 5},
    "Mistral": {"base_url": "https://api.mistral.ai/v1", "api_key_env": "MISTRAL_API_KEY", "default_model": "mistral-small-latest", "free_only": true, "priority": 56},
    "SambaNova": {"base_url": "https://api.sambanova.ai/v1", "api_key_env": "SAMBANOVA_API_KEY", "default_model": "Meta-Llama-3.3-70B-Instruct", "free_only": true, "priority": 57},
    "HuggingFace": {"base_url": "https://router.huggingface.co/v1", "api_key_env": "HF_TOKEN", "default_model": "openai/gpt-oss-120b", "free_only": true, "priority": 58},
    "ZAI": {"base_url": "https://open.bigmodel.cn/api/paas/v4", "api_key_env": "ZAI_API_KEY", "default_model": "glm-4.5-flash", "free_only": true, "priority": 59},
    "LLM7": {"base_url": "https://api.llm7.io/v1", "api_key_env": "LLM7_API_KEY", "default_model": "gpt-oss-120b", "free_only": true, "priority": 61},
    "AnyAPI": {"base_url": "https://api.anyapi.ai/v1", "api_key_env": "ANYAPI_API_KEY", "default_model": "gpt-oss-120b", "free_only": true, "priority": 62},
    "ArliAI": {"base_url": "https://api.arliai.com/v1", "api_key_env": "ARLIAI_API_KEY", "default_model": "Qwen2.5-72B-Instruct", "free_only": true, "priority": 63},
    "OllamaCloud": {"base_url": "https://ollama.com/v1", "api_key_env": "OLLAMA_API_KEY", "default_model": "gpt-oss:20b", "free_only": true, "priority": 64},
    "ModelScope": {"base_url": "https://api-inference.modelscope.cn/v1", "api_key_env": "MODELSCOPE_API_KEY", "default_model": "Qwen/Qwen3-Next-80B-A3B-Instruct", "free_only": true, "priority": 65, "commercial_use": false, "real_name_verification": true}
  }
}
