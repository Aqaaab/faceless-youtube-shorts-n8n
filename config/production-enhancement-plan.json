{
  "schema_version": "1.0",
  "status": "planned_and_contractual",
  "daily_output": {
    "long_form": {"count": 1, "duration_seconds": [420, 900], "source_of_truth": "long_video"},
    "shorts": {"count": 4, "duration_seconds": [28, 59], "source_of_truth": "long_video"}
  },
  "hard_rules": {
    "shorts_must_be_clips_of_long_video": true,
    "shorts_must_reference_long_video_id": true,
    "no_independent_short_topic_generation": true,
    "free_only_ai": true,
    "fail_closed_publication": true,
    "no_deterministic_fallback": true
  },
  "stages": [
    {"id":"trend_intelligence","enabled":true,"outputs":["trend_candidates","topic_score","competition_score","freshness_score"]},
    {"id":"topic_council","enabled":true,"outputs":["council_winner","originality_gate"]},
    {"id":"hook_optimizer","enabled":true,"outputs":["hook_candidates","selected_hook"]},
    {"id":"retention_planner","enabled":true,"outputs":["beat_map","pattern_interrupts","retention_risk"]},
    {"id":"long_story","enabled":true,"outputs":["long_story.json"]},
    {"id":"scene_intelligence","enabled":true,"outputs":["visual_subject","search_query","scene_intent"]},
    {"id":"asset_provenance","enabled":true,"outputs":["asset_manifest","source_urls","reuse_hashes"]},
    {"id":"render","enabled":true,"outputs":["video.mp4","render_contract.json"]},
    {"id":"visual_audio_qa","enabled":true,"outputs":["visual_qa","final_feature_qa"]},
    {"id":"auto_regeneration","enabled":true,"max_attempts_per_scene":3,"fail_closed":true},
    {"id":"short_candidate_engine","enabled":true,"candidate_count":12,"selection_count":4,"source":"video.mp4"},
    {"id":"short_render","enabled":true,"source":"video.mp4","format":"1080x1920","fps":30},
    {"id":"short_qa","enabled":true,"requires_source_range":true,"requires_long_video_id":true},
    {"id":"publication_gate","enabled":true,"requires_all_qa":true},
    {"id":"checkpoint_resume","enabled":true,"states":["PLAN","STORY","VOICE","SCENES","LONG_VIDEO","SHORT_CANDIDATES","SHORTS","QA","LONG_UPLOADED","SHORTS_UPLOADED"]},
    {"id":"analytics_learning","enabled":true,"inputs":["impressions","ctr","average_view_duration","retention","shorts_viewed_vs_swiped","likes","comments","subscribers"],"feeds_next_topic":true}
  ],
  "short_link_contract": {
    "long_upload_first": true,
    "capture_long_video_id": true,
    "assign_related_video_to_each_short": true,
    "persist_mapping": "shorts_long_video_map.json"
  },
  "recovery_policy": {
    "provider_rate_limit": "cooldown_and_try_next_provider",
    "schema_failure": "repair_same_provider_before_excluding",
    "scene_failure": "regenerate_scene_only",
    "partial_run": "resume_from_checkpoint",
    "publish_failure": "retry_idempotently_without_duplicate_upload"
  },
  "quality_gates": {
    "long_duration": [420,900],
    "long_scenes": [18,30],
    "short_duration": [28,59],
    "short_count": 4,
    "short_source_diversity": 4,
    "arabic_subtitles": true,
    "english_spoken": true,
    "english_overlay": false,
    "h264": true,
    "aac_48khz": true,
    "visual_qa": true,
    "final_feature_qa": true,
    "original_story": true
  },
  "rollout_order": [
    "contract_and_validation",
    "provider_reliability",
    "hook_and_retention",
    "scene_regeneration",
    "12_to_4_short_selection",
    "long_video_id_to_short_linking",
    "checkpoint_resume",
    "analytics_learning",
    "production_enablement"
  ]
}
