{
  "schema_version": "2.1",
  "status": "implemented_and_contractual",
  "daily_output": {
    "long_form": {"count": 1, "duration_seconds": [420, 900], "source_of_truth": "long_video"},
    "shorts": {"count": 4, "duration_seconds": [28, 59], "source_of_truth": "long_video"}
  },
  "hard_rules": {
    "shorts_must_be_clips_of_long_video": true,
    "shorts_must_reference_long_video_id": true,
    "no_independent_short_topic_generation": true,
    "free_only_ai": true,
    "fail_closed_publication": true,
    "no_deterministic_fallback": true,
    "provider_fallback_stays_in_same_task": true,
    "fixed_story_slots_never_skip": true,
    "analytics_learning_must_use_real_data_when_credentials_exist": true
  },
  "stages": [
    {"id":"trend_intelligence","enabled":true,"executor":"scripts/youtube_trend_scanner.py","outputs":["trend_candidates","topic_score","competition_score","freshness_score"]},
    {"id":"topic_council","enabled":true,"executor":"scripts/idea_generation_council.py","outputs":["council_winner","originality_gate"]},
    {"id":"hook_optimizer","enabled":true,"executor":"scripts/hook_optimizer.py","outputs":["hook_candidates.json","selected_hook"]},
    {"id":"retention_planner","enabled":true,"executor":"scripts/retention_planner.py","outputs":["retention_simulation.json","beat_map","pattern_interrupts","retention_risk"]},
    {"id":"long_story","enabled":true,"executor":"scripts/patent_story_engine.py","outputs":["long_story.json"]},
    {"id":"scene_intelligence","enabled":true,"executor":"scripts/scene_intelligence.py","outputs":["scene_intelligence.json","visual_subject","search_query","scene_intent"]},
    {"id":"asset_provenance","enabled":true,"executor":"scripts/visual_asset_validator.py","outputs":["visual_qa.json","asset_provenance"],"fail_closed_after_render":true},
    {"id":"render","enabled":true,"executor":"scripts/produce.sh","outputs":["video.mp4","render_contract.json"]},
    {"id":"visual_audio_qa","enabled":true,"executor":"scripts/final_feature_qa.py + scripts/audio_quality_gate.py","outputs":["visual_qa","final_feature_qa","audio_quality.json"]},
    {"id":"auto_regeneration","enabled":true,"executor":"scripts/patent_story_engine.py","max_attempts_per_scene":3,"fail_closed":true},
    {"id":"short_candidate_engine","enabled":true,"executor":"scripts/viral_engine.py","candidate_count":12,"selection_count":4,"source":"video.mp4"},
    {"id":"short_render","enabled":true,"executor":"scripts/short_factory.py","source":"video.mp4","format":"1080x1920","fps":30},
    {"id":"short_qa","enabled":true,"executor":"scripts/short_factory.py + ffprobe","requires_source_range":true,"requires_long_video_id":true},
    {"id":"packaging_optimizer","enabled":true,"executor":"scripts/packaging_optimizer.py","outputs":["packaging_candidates.json","thumbnail_candidates.json"]},
    {"id":"publication_gate","enabled":true,"executor":"daily-production.yml","requires_all_qa":true},
    {"id":"checkpoint_resume","enabled":true,"states":["PLAN","STORY","VOICE","SCENES","LONG_VIDEO","SHORT_CANDIDATES","SHORTS","QA","LONG_UPLOADED","SHORTS_UPLOADED"]},
    {"id":"analytics_collection","enabled":true,"executor":"scripts/youtube_analytics_learning.py","outputs":["youtube_analytics.json"]},
    {"id":"analytics_learning","enabled":true,"executor":"scripts/analytics_learning.py","inputs":["youtube_analytics.json","impressions","ctr","average_view_duration","retention","shorts_viewed_vs_swiped","likes","comments","subscribers"],"feeds_next_topic":true}
  ],
  "executable_stage_contract": {
    "required_files": ["hook_optimizer.py","retention_planner.py","scene_intelligence.py","visual_asset_validator.py","audio_quality_gate.py","packaging_optimizer.py","youtube_analytics_learning.py","analytics_learning.py","production_enhancement_audit.py"],
    "all_must_compile": true,
    "all_must_run_in_daily_orchestrator": true,
    "analytics_collection_runs_on_schedule": true
  },
  "short_link_contract": {
    "long_upload_first": true,
    "capture_long_video_id": true,
    "assign_related_video_to_each_short": true,
    "persist_mapping": "shorts_long_video_map.json"
  },
  "recovery_policy": {
    "provider_rate_limit": "cooldown_and_try_next_provider",
    "schema_failure": "repair_same_provider_before_excluding",
    "scene_failure": "regenerate_scene_only",
    "partial_run": "resume_from_checkpoint",
    "publish_failure": "retry_idempotently_without_duplicate_upload"
  },
  "quality_gates": {
    "long_duration": [420,900],
    "long_scenes": [18,30],
    "fixed_story_scenes": 25,
    "short_duration": [28,59],
    "short_count": 4,
    "short_source_diversity": 4,
    "arabic_subtitles": true,
    "english_spoken": true,
    "english_overlay": false,
    "h264": true,
    "aac_48khz": true,
    "visual_qa": true,
    "final_feature_qa": true,
    "audio_qa": true,
    "original_story": true,
    "hook_score_required": true,
    "retention_plan_required": true,
    "scene_intelligence_required": true,
    "packaging_candidates_required": true
  }
}
