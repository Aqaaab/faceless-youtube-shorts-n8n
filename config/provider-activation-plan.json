{
  "version": 9,
  "purpose": "Provider registry for Aqaaab AI Router. Free-only pool is expanded only with providers that have a documented free path; trial/promotional providers remain disabled by default and every provider requires live inference verification before production use.",
  "policy": {
    "free_only": true,
    "paid_fallback": false,
    "external_services_are_backup": true,
    "live_health_check_required": true,
    "never_assume_model_listing_means_entitlement": true,
    "disabled_by_default": true,
    "max_provider_entries": 100,
    "reject_unverified_free_claims": true
  },
  "providers": [
    {"name":"Mistral","secret":"MISTRAL_API_KEY","enable_env":"ENABLE_MISTRAL_PROVIDER","base_url":"https://api.mistral.ai/v1","model":"mistral-small-latest","role":"backup"},
    {"name":"SambaNova","secret":"SAMBANOVA_API_KEY","enable_env":"ENABLE_SAMBANOVA_PROVIDER","base_url":"https://api.sambanova.ai/v1","model":"Meta-Llama-3.3-70B-Instruct","role":"backup"},
    {"name":"HuggingFace","secret":"HF_TOKEN","enable_env":"ENABLE_HUGGINGFACE_PROVIDER","base_url":"https://router.huggingface.co/v1","model":"openai/gpt-oss-120b","role":"backup"},
    {"name":"LLM7","secret":"LLM7_API_KEY","enable_env":"ENABLE_LLM7_PROVIDER","base_url":"https://api.llm7.io/v1","model":"gpt-oss-120b","role":"backup"},
    {"name":"AnyAPI","secret":"ANYAPI_API_KEY","enable_env":"ENABLE_ANYAPI_PROVIDER","base_url":"https://api.anyapi.ai/v1","model":"gpt-oss-120b","role":"backup"},
    {"name":"ArliAI","secret":"ARLIAI_API_KEY","enable_env":"ENABLE_ARLIAI_PROVIDER","base_url":"https://api.arliai.com/v1","model":"Qwen2.5-72B-Instruct","role":"backup"},
    {"name":"OllamaCloud","secret":"OLLAMA_API_KEY","enable_env":"ENABLE_OLLAMACLOUD_PROVIDER","base_url":"https://ollama.com/v1","model":"gpt-oss:20b","role":"backup"},
    {"name":"ModelScope","secret":"MODELSCOPE_API_KEY","enable_env":"ENABLE_MODELSCOPE_PROVIDER","base_url":"https://api-inference.modelscope.cn/v1","model":"Qwen/Qwen3-Next-80B-A3B-Instruct","role":"last_resort","commercial_use":false,"real_name_verification":true},
    {"name":"Together","secret":"TOGETHER_API_KEY","enable_env":"ENABLE_TOGETHER_PROVIDER","base_url":"https://api.together.ai/v1","model":"Qwen/Qwen3.5-9B","role":"backup","disabled_by_default":true},
    {"name":"OpenCodeZen","secret":"OPENCODE_ZEN_API_KEY","enable_env":"ENABLE_OPENCODE_ZEN_PROVIDER","base_url":"https://opencode.ai/zen/v1","model":"big-pickle","role":"backup","openai_compatible":true,"disabled_by_default":true,"free_models":["big-pickle","minimax-m2.5-free","ring-2.6-1t-free","nemotron-3-super-free"],"promotional_free":true},
    {"name":"SiliconFlow","secret":"SILICONFLOW_API_KEY","enable_env":"ENABLE_SILICONFLOW_PROVIDER","base_url":"https://api.siliconflow.com/v1","model":"Qwen/Qwen3-8B","role":"backup","openai_compatible":true,"disabled_by_default":true,"free_model_required":true},
    {"name":"AIHorde","secret":"AI_HORDE_API_KEY","enable_env":"ENABLE_AI_HORDE_PROVIDER","base_url":"https://oai.aihorde.net/v1","model":"auto","role":"last_resort","openai_compatible":true,"disabled_by_default":true,"anonymous_key_allowed":true,"queue_based":true},
    {"name":"FreeLLMAPI","secret":"FREELLMAPI_API_KEY","enable_env":"ENABLE_FREELLMAPI_PROVIDER","base_url_env":"FREELLMAPI_BASE_URL","model_env":"FREELLMAPI_MODEL","model":"auto","role":"last_resort","openai_compatible":true,"local_or_self_hosted":true},
    {"name":"Ollama","secret":"OLLAMA_API_KEY","enable_env":"ENABLE_OLLAMA_PROVIDER","base_url_env":"OLLAMA_BASE_URL","model_env":"OLLAMA_MODEL","base_url":"http://127.0.0.1:11434/v1","model":"qwen3:8b","role":"local_last_resort","openai_compatible":true,"local_only_by_default":true}
  ],
  "activation_order":["Mistral","SambaNova","HuggingFace","LLM7","AnyAPI","ArliAI","OllamaCloud","ModelScope","Together","OpenCodeZen","SiliconFlow","AIHorde","FreeLLMAPI","Ollama"],
  "built_in_free_only_providers":["OpenRouter","CloudflareWorkersAI"],
  "capacity_note":"The registry supports up to 100 provider entries, but the production pool must contain only independently addressable providers with a verified free entitlement. Multiple models behind one gateway are not counted as independent providers."
}
