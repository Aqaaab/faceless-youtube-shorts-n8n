{
  "version": 2,
  "purpose": "Task-specific provider mesh for YouTube and Instagram production. Every task uses primary -> backup_1 -> backup_2 where independent providers exist; platform-single-source tasks use two explicit adapter strategies instead of pretending they are independent providers.",
  "policy": {
    "prefer_sustainable_free": true,
    "never_treat_trial_credit_as_permanent_free": true,
    "disabled_by_default_until_verified": true,
    "fallback_stays_within_task": true,
    "required_remote_or_local_candidates_per_task": 3,
    "max_remote_candidates_per_task": 8,
    "cache_before_fallback": true,
    "quota_aware": true,
    "health_check_before_activation": true
  },
  "tasks": {
    "research": {"primary":"Tavily","backup_1":"BraveSearch","backup_2":"GDELT","free_path":"Tavily 1000 credits/month; Brave $5/month free credits; GDELT public access","verified":true},
    "trends": {"primary":"GDELT","backup_1":"YouTubeDataAPI","backup_2":"GoogleTrends","free_path":"GDELT public access; YouTube Data API quota; Google Trends public web data via compliant client","verified":true},
    "story": {"primary":"AqaaabAIRouter","backup_1":"Groq","backup_2":"Cerebras","free_path":"Existing provider mesh","verified":true},
    "hook": {"primary":"Groq","backup_1":"Cerebras","backup_2":"Gemini","free_path":"Existing free API tiers subject to rate limits","verified":true},
    "rewrite_qa": {"primary":"Mistral","backup_1":"SambaNova","backup_2":"Groq","free_path":"Existing provider mesh","verified":true},
    "tts": {"primary":"EdgeTTS","backup_1":"Kokoro","backup_2":"Piper","free_path":"Local/self-hosted; no provider API quota","verified":true},
    "speech_to_text": {"primary":"WhisperLocal","backup_1":"AssemblyAI","backup_2":"Deepgram","free_path":"Whisper local; remote free/promo paths disabled by default until live verification","verified":true,"remote_trials_disabled_by_default":true},
    "visual_search": {"primary":"Pexels","backup_1":"Pixabay","backup_2":"Unsplash","free_path":"Pexels 200/hour and 20,000/month by default; Pixabay 100 requests/60s; Unsplash free API with rate limits","verified":true},
    "image_generation": {"primary":"ComfyUI","backup_1":"StableDiffusionLocal","backup_2":"FluxLocal","free_path":"Local/self-hosted; bounded by hardware","verified":true},
    "video_render": {"primary":"FFmpeg","backup_1":"Remotion","backup_2":"MoviePy","free_path":"Open-source/local rendering","verified":true},
    "audio_mix": {"primary":"FFmpeg","backup_1":"SoX","backup_2":"Pydub","free_path":"Open-source/local","verified":true},
    "music": {"primary":"YouTubeAudioLibrary","backup_1":"PixabayMusic","backup_2":"FreeMusicArchive","free_path":"Only publish assets whose current license permits intended use","verified":false,"manual_license_check_required":true},
    "thumbnail": {"primary":"SharpSVG","backup_1":"ImageMagick","backup_2":"Pillow","free_path":"Local rendering","verified":true},
    "media_qa": {"primary":"FFprobe","backup_1":"MediaInfo","backup_2":"Mutagen","free_path":"Local/open-source tooling","verified":true},
    "youtube_publish": {"primary":"YouTubeDataAPI","backup_1":"YouTubeResumableUpload","backup_2":"YouTubeScheduledPublish","platform_single_source":true,"free_path":"Same Google/YouTube platform quota; backups are independent client/transport strategies, not separate services","verified":true},
    "instagram_publish": {"primary":"InstagramGraphAPI","backup_1":"InstagramGraphResumableUpload","backup_2":"InstagramGraphRetryPublisher","platform_single_source":true,"free_path":"Same Meta platform limits; backups are independent client/transport strategies, not separate services","verified":false,"manual_verification_required":true},
    "analytics": {"primary":"YouTubeAnalyticsAPI","backup_1":"YouTubeDataAPIReporting","backup_2":"InstagramInsights","free_path":"Platform APIs; quota/account configuration dependent","verified":false,"manual_verification_required":true}
  },
  "providers": {
    "Tavily":{"task":"research","type":"remote","enabled":false,"free_quota":"1000 credits/month","api_key_env":"TAVILY_API_KEY","base_url":"https://api.tavily.com"},
    "BraveSearch":{"task":"research","type":"remote","enabled":false,"free_quota":"$5 free monthly credits; $5/1000 requests","api_key_env":"BRAVE_SEARCH_API_KEY","base_url":"https://api.search.brave.com"},
    "GDELT":{"task":"research_and_trends","type":"remote_public","enabled":false,"free_quota":"public access; no key","base_url":"https://api.gdeltproject.org"},
    "GoogleTrends":{"task":"trends","type":"public_web_data","enabled":false,"free_quota":"public web data; use compliant client and rate control"},
    "YouTubeDataAPI":{"task":"trends_and_publish","type":"platform","enabled":true,"free_quota":"platform quota","api_key_env":"YOUTUBE_API_KEY","base_url":"https://www.googleapis.com/youtube/v3"},
    "AqaaabAIRouter":{"task":"story","type":"internal_router","enabled":true,"free_quota":"existing provider mesh"},
    "Groq":{"task":"story_and_hook","type":"remote_llm","enabled":true,"free_quota":"provider free tier; rate limited","api_key_env":"GROQ_API_KEY"},
    "Cerebras":{"task":"story_and_hook","type":"remote_llm","enabled":true,"free_quota":"provider free tier; rate limited","api_key_env":"CEREBRAS_API_KEY"},
    "Gemini":{"task":"hook_and_story","type":"remote_llm","enabled":true,"free_quota":"provider free tier; rate limited","api_key_env":"GEMINI_API_KEY"},
    "Mistral":{"task":"rewrite_qa","type":"remote_llm","enabled":true,"free_quota":"provider free path","api_key_env":"MISTRAL_API_KEY"},
    "SambaNova":{"task":"rewrite_qa","type":"remote_llm","enabled":true,"free_quota":"provider free path","api_key_env":"SAMBANOVA_API_KEY"},
    "EdgeTTS":{"task":"tts","type":"local_wrapper","enabled":true,"free_quota":"no provider API quota","binary":"edge-tts"},
    "Kokoro":{"task":"tts","type":"local_model","enabled":true,"free_quota":"no provider API quota","model":"kokoro-v1.0.onnx"},
    "Piper":{"task":"tts","type":"local_model","enabled":false,"free_quota":"no provider API quota","model":"piper"},
    "WhisperLocal":{"task":"speech_to_text","type":"local_model","enabled":true,"free_quota":"no provider API quota","model":"whisper"},
    "AssemblyAI":{"task":"speech_to_text","type":"remote_trial","enabled":false,"free_quota":"current free account offer must be verified live","api_key_env":"ASSEMBLYAI_API_KEY","base_url":"https://api.assemblyai.com"},
    "Deepgram":{"task":"speech_to_text","type":"remote_trial","enabled":false,"free_quota":"current promotional offer must be verified live","api_key_env":"DEEPGRAM_API_KEY","base_url":"https://api.deepgram.com"},
    "Pexels":{"task":"visual_search","type":"remote","enabled":true,"free_quota":"200/hour, 20,000/month by default; eligible apps may request unlimited","api_key_env":"PEXELS_API_KEY","base_url":"https://api.pexels.com"},
    "Pixabay":{"task":"visual_search","type":"remote","enabled":false,"free_quota":"100 requests/60 seconds; cache required","api_key_env":"PIXABAY_API_KEY","base_url":"https://pixabay.com/api"},
    "Unsplash":{"task":"visual_search","type":"remote","enabled":false,"free_quota":"free API; current default rate limit depends on app status","api_key_env":"UNSPLASH_ACCESS_KEY","base_url":"https://api.unsplash.com"},
    "ComfyUI":{"task":"image_generation","type":"local_server","enabled":false,"free_quota":"no provider API quota","base_url_env":"COMFYUI_BASE_URL"},
    "StableDiffusionLocal":{"task":"image_generation","type":"local_model","enabled":false,"free_quota":"no provider API quota"},
    "FluxLocal":{"task":"image_generation","type":"local_model","enabled":false,"free_quota":"no provider API quota"},
    "FFmpeg":{"task":"video_render_and_audio_mix","type":"local_tool","enabled":true,"free_quota":"no provider API quota","binary":"ffmpeg"},
    "Remotion":{"task":"video_render","type":"local_tool","enabled":false,"free_quota":"open-source/local rendering","binary":"remotion"},
    "MoviePy":{"task":"video_render","type":"local_library","enabled":false,"free_quota":"open-source/local rendering"},
    "SoX":{"task":"audio_mix","type":"local_tool","enabled":false,"free_quota":"no provider API quota","binary":"sox"},
    "Pydub":{"task":"audio_mix","type":"local_library","enabled":false,"free_quota":"open-source/local"},
    "YouTubeAudioLibrary":{"task":"music","type":"platform_library","enabled":false,"free_quota":"license-dependent platform library","manual_license_check_required":true},
    "PixabayMusic":{"task":"music","type":"catalog","enabled":false,"free_quota":"license-dependent","manual_license_check_required":true},
    "FreeMusicArchive":{"task":"music","type":"catalog","enabled":false,"free_quota":"license-dependent","manual_license_check_required":true},
    "SharpSVG":{"task":"thumbnail","type":"local_library","enabled":true,"free_quota":"no provider API quota"},
    "ImageMagick":{"task":"thumbnail","type":"local_tool","enabled":false,"free_quota":"no provider API quota","binary":"magick"},
    "Pillow":{"task":"thumbnail","type":"local_library","enabled":false,"free_quota":"no provider API quota"},
    "FFprobe":{"task":"media_qa","type":"local_tool","enabled":true,"free_quota":"no provider API quota","binary":"ffprobe"},
    "MediaInfo":{"task":"media_qa","type":"local_tool","enabled":false,"free_quota":"no provider API quota","binary":"mediainfo"},
    "Mutagen":{"task":"media_qa","type":"local_library","enabled":false,"free_quota":"no provider API quota"},
    "YouTubeResumableUpload":{"task":"youtube_publish","type":"platform_adapter","enabled":true,"free_quota":"same YouTube quota","platform_single_source":true},
    "YouTubeScheduledPublish":{"task":"youtube_publish","type":"platform_adapter","enabled":true,"free_quota":"same YouTube quota","platform_single_source":true},
    "InstagramGraphAPI":{"task":"instagram_publish","type":"platform","enabled":false,"free_quota":"verify current product/account limits","api_key_env":"INSTAGRAM_ACCESS_TOKEN","base_url":"https://graph.facebook.com"},
    "InstagramGraphResumableUpload":{"task":"instagram_publish","type":"platform_adapter","enabled":false,"free_quota":"same Meta quota","platform_single_source":true},
    "InstagramGraphRetryPublisher":{"task":"instagram_publish","type":"platform_adapter","enabled":false,"free_quota":"same Meta quota","platform_single_source":true},
    "YouTubeAnalyticsAPI":{"task":"analytics","type":"platform","enabled":false,"free_quota":"platform quota","api_key_env":"YOUTUBE_API_KEY","base_url":"https://youtubeanalytics.googleapis.com"},
    "YouTubeDataAPIReporting":{"task":"analytics","type":"platform_adapter","enabled":false,"free_quota":"same YouTube quota","platform_single_source":true},
    "InstagramInsights":{"task":"analytics","type":"platform","enabled":false,"free_quota":"verify current product/account limits","api_key_env":"INSTAGRAM_ACCESS_TOKEN","base_url":"https://graph.facebook.com"}
  }
}
