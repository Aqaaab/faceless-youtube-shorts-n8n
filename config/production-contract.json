{
  "schema_version": 1,
  "canonical_workflow": ".github/workflows/daily-production.yml",
  "validation_workflow": ".github/workflows/ai-router-validation.yml",
  "production": {
    "long_video_count": 1,
    "long_duration_seconds": {"min": 420, "max": 900},
    "long_scenes": {"min": 18, "max": 30},
    "long_words": {"min": 1050, "max": 2100},
    "short_count": 4,
    "short_duration_seconds": {"min": 28, "max": 59},
    "short_resolution": [1080, 1920],
    "short_video_codec": "h264",
    "short_fps": 30
  },
  "routing": {
    "free_only": true,
    "fail_closed": true,
    "fallbacks_per_task": 3,
    "fixed_slots": 5,
    "scenes_per_slot": 5,
    "slot_ranges": [[1,5],[6,10],[11,15],[16,20],[21,25]],
    "failed_slot_must_not_skip": true
  },
  "artifacts": {
    "final_prefix": "daily-production-final-",
    "required": ["video.mp4", "production_contract.json", "shorts/short-1.mp4", "shorts/short-2.mp4", "shorts/short-3.mp4", "shorts/short-4.mp4"]
  },
  "legacy": {
    "forbidden_workflow_files": [".github/workflows/daily-production-v2.yml"],
    "forbidden_artifact_prefixes": ["daily-production-v2-final-"]
  }
}
