# ----------------------------------------------------------------------------
# Copy to .env for the self-hosted n8n/Docker deployment.
# GitHub Actions uses repository Secrets instead of this file.
# ----------------------------------------------------------------------------

# Odysseus primary intelligence gateway (optional; disabled by default)
ODYSSEUS_GATEWAY_ENABLED=false
ODYSSEUS_GATEWAY_HOST=127.0.0.1
ODYSSEUS_GATEWAY_PORT=8787
ODYSSEUS_GATEWAY_BASE_URL=http://127.0.0.1:8787/v1
ODYSSEUS_GATEWAY_API_KEY=

# Core AI providers
GEMINI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=

# Additional OpenAI-compatible AI providers
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
HF_TOKEN=
LLM7_API_KEY=
ANYAPI_API_KEY=
ARLIAI_API_KEY=
OLLAMA_API_KEY=
MODELSCOPE_API_KEY=
TOGETHER_API_KEY=

# Newly supported free/conditional providers
OPENCODE_ZEN_API_KEY=
SILICONFLOW_API_KEY=
AI_HORDE_API_KEY=0000000000

# FreeLLMAPI unified gateway. The endpoint must be an actual reachable FreeLLMAPI
# server exposing /v1/models and /v1/chat/completions.
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=
FREELLMAPI_MODEL=auto

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b

# Primary BlockRun free pool requires no key.
QWENCLOUD_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Provider activation flags. Keep false locally unless free access is verified.
ENABLE_MISTRAL_PROVIDER=false
ENABLE_SAMBANOVA_PROVIDER=false
ENABLE_HUGGINGFACE_PROVIDER=false
ENABLE_LLM7_PROVIDER=false
ENABLE_ANYAPI_PROVIDER=false
ENABLE_ARLIAI_PROVIDER=false
ENABLE_OLLAMACLOUD_PROVIDER=false
ENABLE_MODELSCOPE_PROVIDER=false
ENABLE_TOGETHER_PROVIDER=false
ENABLE_OPENCODE_ZEN_PROVIDER=false
ENABLE_SILICONFLOW_PROVIDER=false
ENABLE_AI_HORDE_PROVIDER=false
ENABLE_FREELLMAPI_PROVIDER=false
ENABLE_OLLAMA_PROVIDER=false

# Pexels — stock video source used by the production renderer.
PEXELS_API_KEY=

# Local n8n timezone. GitHub Actions schedules are UTC.
TIMEZONE=UTC

# Optional local music file.
MUSIC_FILE=

# Local YouTube OAuth values. GitHub Actions uses repository Secrets.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private
