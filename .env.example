# ----------------------------------------------------------------------------
# Copy to .env for the self-hosted n8n/Docker deployment.
# GitHub Actions uses repository Secrets instead of this file.
# ----------------------------------------------------------------------------

# Gemini API key used by the GitHub Actions content generator when running the
# production workflow. Get one from Google AI Studio.
GEMINI_API_KEY=

# Optional Groq key for the legacy n8n-generated workflows in workflows/.
GROQ_API_KEY=

# Pexels — stock video source used by the production renderer.
PEXELS_API_KEY=

# Local n8n timezone. GitHub Actions schedules are UTC.
TIMEZONE=UTC

# Optional local music file. The renderer also searches assets/music.mp3 and
# assets/background.mp3 when running under GitHub Actions or a mounted workspace.
MUSIC_FILE=

# Local YouTube OAuth values are only needed when running scripts/upload_youtube.py
# directly outside GitHub Actions. GitHub Actions reads these from repository Secrets.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private
